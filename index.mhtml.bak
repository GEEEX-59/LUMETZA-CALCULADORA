<body>
<header>
 <div class=3D"top">
  <div class=3D"brand"><div class=3D"logo" aria-label=3D"Logo L">L</div><di=
v><h1>LUMETZA</h1><p>Calculadora solar interactiva</p></div></div>
  <div class=3D"chip">=E2=98=80 Energ=C3=ADa a tu medida</div>
 </div>
 <div class=3D"hero"><h2>Tu energ=C3=ADa, dise=C3=B1ada con luz.</h2><p>Cal=
cula el consumo de tus equipos y estima paneles, banco de bater=C3=ADas, in=
versor y controlador en un solo lugar.</p></div>
</header>
<main>
 <section class=3D"card">
  <h2 class=3D"section-title"><span class=3D"icon">=E2=9A=99=EF=B8=8F</span=
> Par=C3=A1metros del sistema</h2>
  <div class=3D"controls">
   <div class=3D"field"><label for=3D"sun">Horas solares pico al d=C3=ADa</=
label><input id=3D"sun" type=3D"number" min=3D"1" step=3D".1" value=3D"6"><=
/div>
   <div class=3D"field"><label for=3D"panelW">Potencia por panel (W)</label=
><input id=3D"panelW" type=3D"number" min=3D"1" step=3D"1" value=3D"100"></=
div>
   <div class=3D"field"><label for=3D"panelEff">Eficiencia del sistema/pane=
l (%)</label><input id=3D"panelEff" type=3D"number" min=3D"1" max=3D"100" s=
tep=3D"1" value=3D"60"></div>
   <div class=3D"field"><label for=3D"storage">D=C3=ADas de almacenamiento<=
/label><input id=3D"storage" type=3D"number" min=3D"1" max=3D"30" step=3D"1=
" value=3D"5"></div>
   <div class=3D"field"><label for=3D"bankV">Voltaje del banco (V)</label><=
select id=3D"bankV"><option>12</option><option selected=3D"">24</option><op=
tion>48</option></select></div>
   <div class=3D"field"><label for=3D"battery">Tipo de bater=C3=ADa</label>=
<select id=3D"battery"><option value=3D"127">12 V =C2=B7 127 Ah</option><op=
tion value=3D"220">12 V =C2=B7 220 Ah</option></select></div>
   <div class=3D"field"><label for=3D"dod">Profundidad de descarga recomend=
ada (%)</label><input id=3D"dod" type=3D"number" min=3D"10" max=3D"100" val=
ue=3D"80"></div>
   <div class=3D"field"><label for=3D"batEff">Eficiencia de bater=C3=ADa (%=
)</label><input id=3D"batEff" type=3D"number" min=3D"1" max=3D"100" value=
=3D"90"></div>
   <div class=3D"field"><label for=3D"invEff">Eficiencia del inversor (%)</=
label><input id=3D"invEff" type=3D"number" min=3D"1" max=3D"100" value=3D"8=
5"></div>
   <div class=3D"field"><label for=3D"controllerEff">Factor para controlado=
r</label><input id=3D"controllerEff" type=3D"number" min=3D"1" step=3D".1" =
value=3D"1.25"><div class=3D"hint">Margen de dise=C3=B1o (ej. 1.25)</div></=
div>
  </div>
 </section>
